<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BambooDeploy.Sign</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bamboo-sign</ToolCommandName>
    <PackageId>BambooDeploy.Sign</PackageId>
    <Version>1.0.0</Version>
    <Authors>Bamboo Deploy</Authors>
    <Company>Bamboo Deploy</Company>
    <Description>Scan and code-sign Windows .exe and .msi files from dotnet publish, MSBuild, or any build script via the Bamboo Deploy API. No certificate or hardware token to manage.</Description>
    <PackageTags>code-signing;authenticode;signtool;windows;smartscreen;msbuild;publish;installer</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.bamboodeploy.com/docs/#dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bamboodeploy/dotnet-sign</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
